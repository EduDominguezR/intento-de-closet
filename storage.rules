rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidImageUpload(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('image/(webp|png|jpeg)');
    }

    match /garments/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidImageUpload(3 * 1024 * 1024);
      allow delete: if isOwner(uid);
    }

    match /outfits/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidImageUpload(3 * 1024 * 1024);
      allow delete: if isOwner(uid);
    }

    match /lookbook/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidImageUpload(5 * 1024 * 1024);
      allow delete: if isOwner(uid);
    }
  }
}
