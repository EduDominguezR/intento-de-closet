# ==============================================================================
# Closetly funciona SIN API keys de pago ni Cloud Functions.
# - Firebase se autoconfigura automáticamente desde firebase-applet-config.json.
# - Recorte de fondo: gratuito en navegador (imgly + varita mágica solid-bg + pincel).
# - Detección de pose y segmentación: gratuita y local (/public/mediapipe/).
# - Vista 3D: procedural + decoders gratuitos sin clave.
# ==============================================================================

# Opcional: App Check con reCAPTCHA v3 (si está vacía, App Check NO se inicializa).
# Verifica la cuota gratuita vigente del proveedor antes de activar modo Enforce.
VITE_APPCHECK_RECAPTCHA_SITE_KEY=

# Solo usa estas variables si despliegas manualmente fuera de AI Studio con otro proyecto Firebase:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=
